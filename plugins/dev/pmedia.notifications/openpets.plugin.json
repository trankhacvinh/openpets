{
  "manifestVersion": 3,
  "id": "pmedia.notifications",
  "name": "$t:plugin.name",
  "description": "$t:plugin.description",
  "version": "0.1.0",
  "runtime": "javascript",
  "icon": "bell",
  "sdkVersion": "3.0.0",
  "entry": "index.js",
  "permissions": [
    "pet:speak",
    "pet:interact",
    "pet:reaction",
    "audio",
    "schedule",
    "storage",
    "commands",
    "status",
    "notify",
    "system:openExternal"
  ],
  "configSchema": {
    "minSeverity": {
      "type": "select",
      "default": "info",
      "label": "$t:config.minSeverity.label",
      "description": "$t:config.minSeverity.description",
      "options": [
        { "value": "info", "label": "$t:severity.info" },
        { "value": "success", "label": "$t:severity.success" },
        { "value": "warning", "label": "$t:severity.warning" },
        { "value": "error", "label": "$t:severity.error" },
        { "value": "urgent", "label": "$t:severity.urgent" }
      ]
    },
    "soundEnabled": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.soundEnabled.label",
      "description": "$t:config.soundEnabled.description"
    },
    "osNotificationEnabled": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.osNotificationEnabled.label",
      "description": "$t:config.osNotificationEnabled.description"
    },
    "pollingEnabled": {
      "type": "boolean",
      "default": false,
      "label": "$t:config.pollingEnabled.label",
      "description": "$t:config.pollingEnabled.description"
    },
    "pollIntervalSeconds": {
      "type": "number",
      "default": 60,
      "label": "$t:config.pollIntervalSeconds.label",
      "description": "$t:config.pollIntervalSeconds.description"
    }
  }
}
