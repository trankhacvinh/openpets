{
  "manifestVersion": 3,
  "id": "pmedia.notifications",
  "name": "$t:plugin.name",
  "description": "$t:plugin.description",
  "version": "0.3.0",
  "runtime": "javascript",
  "icon": "bell",
  "sdkVersion": "3.0.0",
  "entry": "index.js",
  "permissions": [
    "pet:speak",
    "pet:interact",
    "pet:reaction",
    "audio",
    "schedule",
    "storage",
    "commands",
    "status",
    "notify",
    "system:openExternal",
    "network",
    "network:write"
  ],
  "network": {
    "hosts": [
      "agent-api.pmedia.vn",
      "api.pmedia.vn",
      "pmedia.vn",
      "chamcong.pmedia.vn",
      "logistics.pmedia.vn",
      "crm.pmedia.vn"
    ]
  },
  "configSchema": {
    "minSeverity": {
      "type": "select",
      "default": "info",
      "label": "$t:config.minSeverity.label",
      "description": "$t:config.minSeverity.description",
      "options": [
        { "value": "info", "label": "$t:severity.info" },
        { "value": "success", "label": "$t:severity.success" },
        { "value": "warning", "label": "$t:severity.warning" },
        { "value": "error", "label": "$t:severity.error" },
        { "value": "urgent", "label": "$t:severity.urgent" }
      ]
    },
    "soundEnabled": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.soundEnabled.label",
      "description": "$t:config.soundEnabled.description"
    },
    "osNotificationEnabled": {
      "type": "boolean",
      "default": true,
      "label": "$t:config.osNotificationEnabled.label",
      "description": "$t:config.osNotificationEnabled.description"
    },
    "pollingEnabled": {
      "type": "boolean",
      "default": false,
      "label": "$t:config.pollingEnabled.label",
      "description": "$t:config.pollingEnabled.description"
    },
    "pollIntervalSeconds": {
      "type": "number",
      "default": 60,
      "min": 30,
      "max": 3600,
      "label": "$t:config.pollIntervalSeconds.label",
      "description": "$t:config.pollIntervalSeconds.description"
    },
    "sources": {
      "type": "list",
      "default": [],
      "maxItems": 20,
      "label": "$t:config.sources.label",
      "description": "$t:config.sources.description",
      "itemSchema": {
        "id": {
          "type": "text",
          "label": "$t:config.sources.id.label",
          "description": "$t:config.sources.id.description"
        },
        "type": {
          "type": "select",
          "default": "generic-api",
          "label": "$t:config.sources.type.label",
          "description": "$t:config.sources.type.description",
          "options": [
            { "value": "generic-api", "label": "$t:sourceType.genericApi" },
            { "value": "notification-gateway", "label": "$t:sourceType.gateway" },
            { "value": "github", "label": "$t:sourceType.github" },
            { "value": "custom-adapter", "label": "$t:sourceType.customAdapter" }
          ]
        },
        "name": {
          "type": "text",
          "label": "$t:config.sources.name.label",
          "description": "$t:config.sources.name.description"
        },
        "baseUrl": {
          "type": "text",
          "label": "$t:config.sources.baseUrl.label",
          "description": "$t:config.sources.baseUrl.description"
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "label": "$t:config.sources.enabled.label",
          "description": "$t:config.sources.enabled.description"
        },
        "authType": {
          "type": "select",
          "default": "none",
          "label": "$t:config.sources.authType.label",
          "description": "$t:config.sources.authType.description",
          "options": [
            { "value": "none", "label": "$t:auth.none" },
            { "value": "bearer", "label": "$t:auth.bearer" },
            { "value": "api-key", "label": "$t:auth.apiKey" }
          ]
        }
      }
    }
  }
}
